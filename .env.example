# Puente Salud · variables de entorno del backend
# Copia este archivo a .env y cambia los valores. .env nunca se sube a git.

# ---------- Base de datos (local: contenedor `db` de docker compose) ----------
POSTGRES_USER=puente_admin
POSTGRES_PASSWORD=cambia-esto-admin
POSTGRES_DB=puente_salud
# Usuario de la aplicación con permisos limitados (lo crea db/init/01-roles.sh)
APP_DB_USER=puente_app
APP_DB_PASSWORD=cambia-esto-app
# Conexiones (local). En producción (Railway) usa la URL de su PostgreSQL con PostGIS.
DATABASE_ADMIN_URL=postgresql://puente_admin:cambia-esto-admin@db:5432/puente_salud
DATABASE_URL=postgresql://puente_app:cambia-esto-app@db:5432/puente_salud

# ---------- Gateway ----------
# Secreto para firmar los tokens de sesión (cadena larga y aleatoria)
TOKEN_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
# Secreto compartido gateway -> servicios internos
INTERNAL_TOKEN=cambia-esto-interno
# Orígenes permitidos (coma). Local: los dos frontends. Producción: sus dominios de Vercel.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Producción (ejemplo): CORS_ORIGINS=https://puente-salud-ciudadania.vercel.app,https://puente-salud-institucion.vercel.app
SEGUIMIENTO_URL=http://seguimiento:8001
TERRITORIO_URL=http://territorio:8002
# Cuentas de demostración del panel institucional (JSON). Contraseñas de demostración, no reales.
DEMO_USERS=[{"usuario":"enfermeria.tateposco","password":"demo-salud","rol":"personal_salud","nombre":"Enf. Laura Méndez","clues":"JCSSA005951"},{"usuario":"medicina.lasjuntas","password":"demo-salud","rol":"personal_salud","nombre":"Dr. Ramón Ibarra","clues":"JCSSA006021"},{"usuario":"autoridad.rxii","password":"demo-autoridad","rol":"autoridad","nombre":"Coordinación Región Sanitaria XII","clues":null}]
# Horas de validez del token
TOKEN_HORAS=8

# ---------- Datos simulados ----------
# Fecha de referencia del recorrido simulado (vacío = día en que se carga)
FECHA_REFERENCIA=

# ---------- Puerto (Railway lo inyecta) ----------
PORT=8000
