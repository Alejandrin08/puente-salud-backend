# Trabajo de una sola vez: aplica migraciones y carga los datos (reales y simulados).
# Contexto de construcción: raíz del backend.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY services/seguimiento/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY db ./db
COPY scripts/seed.py ./scripts/seed.py
CMD ["python", "scripts/seed.py", "--si-vacio"]
